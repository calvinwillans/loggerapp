<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp
    xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
    xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides"
    xsi:type="TaskPaneApp">

  <Id>d4b2f7b1-9a3c-4c0f-af88-3c7f2b5e6a21</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>RAC Arena</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Venue Logger" />
  <Description DefaultValue="One-line shorthand entry, logged straight to the Log sheet via a floating box." />
  <IconUrl DefaultValue="https://calvinwillans.github.io/loggerapp/assets/icon-32.png" />
  <HighResIconUrl DefaultValue="https://calvinwillans.github.io/loggerapp/assets/icon-80.png" />
  <SupportUrl DefaultValue="https://calvinwillans.github.io/loggerapp" />

  <AppDomains>
    <AppDomain>https://calvinwillans.github.io/loggerapp</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Workbook" />
  </Hosts>

  <Requirements>
    <Sets DefaultMinVersion="1.1">
      <Set Name="DialogApi" MinVersion="1.2" />
      <Set Name="SharedRuntime" MinVersion="1.1" />
    </Sets>
  </Requirements>

  <DefaultSettings>
    <SourceLocation DefaultValue="https://calvinwillans.github.io/loggerapp/commands.html" />
  </DefaultSettings>

  <Permissions>ReadWriteDocument</Permissions>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Hosts>
      <Host xsi:type="Workbook">
        <!-- Keeps commands.html alive persistently for the whole session (not just
             for the moment a button is clicked or a dialog message arrives), so
             the worksheet.onChanged listener registered in commands.js can keep
             firing in the background. -->
        <Runtimes>
          <Runtime resid="Commands.Url" lifetime="long" />
        </Runtimes>
        <DesktopFormFactor>
          <GetStarted>
            <Title resid="GetStarted.Title" />
            <Description resid="GetStarted.Description" />
            <LearnMoreUrl resid="GetStarted.LearnMoreUrl" />
          </GetStarted>
          <FunctionFile resid="Commands.Url" />
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="VenueLogger.Group1">
                <Label resid="VenueLogger.Group1Label" />
                <Icon>
                  <bt:Image size="16" resid="Icon.16x16" />
                  <bt:Image size="32" resid="Icon.32x32" />
                  <bt:Image size="80" resid="Icon.80x80" />
                </Icon>
                <!-- ExecuteFunction = no task pane. Clicking this just opens the
                     floating dialog directly, and the dialog is independent of
                     this button once it's open. -->
                <Control xsi:type="Button" id="VenueLogger.OpenButton">
                  <Label resid="VenueLogger.OpenButton.Label" />
                  <Supertip>
                    <Title resid="VenueLogger.OpenButton.Label" />
                    <Description resid="VenueLogger.OpenButton.Tooltip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16" />
                    <bt:Image size="32" resid="Icon.32x32" />
                    <bt:Image size="80" resid="Icon.80x80" />
                  </Icon>
                  <Action xsi:type="ExecuteFunction">
                    <FunctionName>openLogger</FunctionName>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16x16" DefaultValue="https://calvinwillans.github.io/loggerapp/assets/icon-16.png" />
        <bt:Image id="Icon.32x32" DefaultValue="https://calvinwillans.github.io/loggerapp/assets/icon-32.png" />
        <bt:Image id="Icon.80x80" DefaultValue="https://calvinwillans.github.io/loggerapp/assets/icon-80.png" />
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Commands.Url" DefaultValue="https://calvinwillans.github.io/loggerapp/commands.html" />
        <bt:Url id="GetStarted.LearnMoreUrl" DefaultValue="https://calvinwillans.github.io/loggerapp" />
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GetStarted.Title" DefaultValue="Get started with Venue Logger" />
        <bt:String id="VenueLogger.Group1Label" DefaultValue="Venue Logger" />
        <bt:String id="VenueLogger.OpenButton.Label" DefaultValue="Open Logger" />
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="GetStarted.Description" DefaultValue="Click once to open the floating logger box. It stays open - type shorthand and press Enter." />
        <bt:String id="VenueLogger.OpenButton.Tooltip" DefaultValue="Opens a floating box for fast shorthand logging" />
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
